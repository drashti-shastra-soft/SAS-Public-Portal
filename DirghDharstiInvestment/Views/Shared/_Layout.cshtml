                                <ul>
                                    <li><a href="@Url.Action("Index", "Health")">Health Insurance</a></li>
                                    <li><a href="@Url.Action("Index", "CarInsurance")">Car Insurance</a></li>
                                    <li><a href="@Url.Action("Index", "BikeInsurance")">Bike Insurance</a></li>
                                    <li><a href="@Url.Action("Index", "PropertyInsurance")">Property Insurance</a></li>

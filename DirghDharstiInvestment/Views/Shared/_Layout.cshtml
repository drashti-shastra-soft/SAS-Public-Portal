                        <li><a href="@Url.Action("Index", "Investment")">Investment</a></li>
                        <li><a href="@Url.Action("Index", "Insurance")">Life Insurance</a></li>
                        <li><a href="@Url.Action("Index", "GeneralInsurance")">General Education</a></li>
